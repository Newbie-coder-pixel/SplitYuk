# Copy to .env.local for `vercel dev`, or set these in the Vercel project's
# Environment Variables. Never commit a real .env file.

# Fonnte (WhatsApp) — https://fonnte.com
# FONNTE_API_KEY is the *device* token, from the Token button next to the
# device in Fonnte's dashboard (not the account token).
FONNTE_API_KEY=
# Optional but recommended: the number that device is linked to. WhatsApp
# will not deliver a message to the device that sent it, and Fonnte
# reports that case as a success, so setting this turns a silent
# non-delivery into a clear error.
FONNTE_DEVICE_NUMBER=

# Resend (Email fallback) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Upstash Redis (rate-limit + anonymized metrics only — PRD §12/§13)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini (AI receipt reading) — https://aistudio.google.com/apikey
# Free tier. GEMINI_MODEL is optional; only set it to override the default
# in lib/gemini.ts (useful if that model id goes stale).
GEMINI_API_KEY=
GEMINI_MODEL=
